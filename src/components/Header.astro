---
// Header.astro — Glassmorphic sticky navigation with mega menu
// Uses Alpine.js for interactivity (no JS framework needed)
---

<header
  class="glass-header sticky top-0 z-50"
  x-data="{
    mobileOpen: false,
    megaOpen: false,
    isDark: document.documentElement.classList.contains('dark'),
    toggleDark() {
      this.isDark = !this.isDark;
      document.documentElement.classList.toggle('dark', this.isDark);
      document.documentElement.classList.toggle('light', !this.isDark);
      localStorage.setItem('theme', this.isDark ? 'dark' : 'light');
    }
  }"
  x-cloak
>
  <div class="container" style="display:flex; align-items:center; justify-content:space-between; padding-block: 0.75rem;">

    <!-- ── Brand Logo ── -->
    <a href="/" class="brand-logo" style="display:flex; align-items:center; gap:0.5rem; text-decoration:none;">
      <span class="material-symbols-outlined" style="font-size:2rem; color:var(--color-primary);">account_balance</span>
      <span class="text-headline-sm" style="color:var(--color-primary); font-weight:700; letter-spacing:-0.01em;">Govt Tools</span>
    </a>

    <!-- ── Desktop Navigation ── -->
    <nav class="desktop-nav" style="display:none; align-items:center; gap:2rem;">

      <!-- Home -->
      <a href="/" class="nav-link active" aria-current="page">
        <span class="bangla-text">হোম</span>
        <span class="nav-active-bar"></span>
      </a>

      <!-- All Tools — with mega menu -->
      <div
        style="position:relative;"
        @mouseenter="megaOpen = true"
        @mouseleave="megaOpen = false"
      >
        <button class="nav-link nav-btn" :aria-expanded="megaOpen">
          <span class="bangla-text">সবগুলো টুলস</span>
          <span
            class="material-symbols-outlined"
            style="font-size:1.1rem; transition: transform 0.3s;"
            :style="megaOpen ? 'transform: rotate(180deg)' : ''"
          >keyboard_arrow_down</span>
        </button>

        <!-- Mega Menu -->
        <div class="mega-menu" :class="{ open: megaOpen }" role="menu">
          <div style="display:grid; grid-template-columns: repeat(4,1fr); gap:2rem; padding:2rem;">

            <!-- Finance -->
            <div>
              <div style="display:flex; align-items:center; gap:0.5rem; color:var(--color-primary); margin-bottom:1rem;">
                <span class="material-symbols-outlined" style="font-size:1.25rem;">payments</span>
                <span style="font-weight:700;" class="bangla-text">আর্থিক ও বেতন</span>
              </div>
              <ul style="list-style:none; display:flex; flex-direction:column; gap:0.75rem;">
                <li><a href="/tools/pay-scale-2026" class="mega-link bangla-text">পে স্কেল ২০২৬</a></li>
                <li><a href="/tools/salary" class="mega-link bangla-text">বেতন ক্যালকুলেটর</a></li>
                <li><a href="/tools/gpf" class="mega-link bangla-text">জিপিএফ মুনাফা</a></li>
                <li><a href="/tools/tax" class="mega-link bangla-text">আয়কর হেল্পার</a></li>
              </ul>
            </div>

            <!-- Pension -->
            <div>
              <div style="display:flex; align-items:center; gap:0.5rem; color:var(--color-primary); margin-bottom:1rem;">
                <span class="material-symbols-outlined" style="font-size:1.25rem;">elderly</span>
                <span style="font-weight:700;" class="bangla-text">পেনশন ও অবসর</span>
              </div>
              <ul style="list-style:none; display:flex; flex-direction:column; gap:0.75rem;">
                <li><a href="/tools/pension" class="mega-link bangla-text">পেনশন ক্যালকুলেটর</a></li>
                <li><a href="/tools/pension-commutation" class="mega-link bangla-text">পেনশন সমর্পণ</a></li>
                <li><a href="/tools/family-pension" class="mega-link bangla-text">পারিবারিক পেনশন</a></li>
                <li><a href="/tools/lpr" class="mega-link bangla-text">এলপিআর নগদায়ন</a></li>
              </ul>
            </div>

            <!-- Utility -->
            <div>
              <div style="display:flex; align-items:center; gap:0.5rem; color:var(--color-primary); margin-bottom:1rem;">
                <span class="material-symbols-outlined" style="font-size:1.25rem;">construction</span>
                <span style="font-weight:700;" class="bangla-text">ইউটিলিটি টুলস</span>
              </div>
              <ul style="list-style:none; display:flex; flex-direction:column; gap:0.75rem;">
                <li><a href="/tools/pdf-to-word" class="mega-link">PDF to Word</a></li>
                <li><a href="/tools/photo-resizer" class="mega-link">Photo Resizer</a></li>
                <li><a href="/tools/compressor" class="mega-link bangla-text">ফাইল কম্প্রেসর</a></li>
                <li><a href="/tools/verification" class="mega-link bangla-text">ডকুমেন্ট ভেরিফিকেশন</a></li>
              </ul>
            </div>

            <!-- Admin -->
            <div>
              <div style="display:flex; align-items:center; gap:0.5rem; color:var(--color-primary); margin-bottom:1rem;">
                <span class="material-symbols-outlined" style="font-size:1.25rem;">badge</span>
                <span style="font-weight:700;" class="bangla-text">প্রশাসন ও রেকর্ড</span>
              </div>
              <ul style="list-style:none; display:flex; flex-direction:column; gap:0.75rem;">
                <li><a href="/tools/service-age" class="mega-link bangla-text">চাকুরির বয়স</a></li>
                <li><a href="/tools/earned-leave" class="mega-link bangla-text">অর্জিত ছুটি</a></li>
                <li><a href="/tools/seniority" class="mega-link bangla-text">জ্যেষ্ঠতা র‍্যাংক</a></li>
                <li><a href="/tools/increment-reminder" class="mega-link bangla-text">ইনক্রিমেন্ট রিমাইন্ডার</a></li>
              </ul>
            </div>
          </div>

          <!-- Mega footer -->
          <div style="background:var(--color-surface-container-low); padding:1rem 2rem; text-align:center; border-top: 1px solid var(--color-outline-variant);">
            <a href="/tools" class="mega-link" style="font-weight:700; display:inline-flex; align-items:center; gap:0.25rem;">
              <span class="bangla-text">সবগুলো টুলস পেজ দেখুন</span>
              <span class="material-symbols-outlined" style="font-size:1rem;">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Blog -->
      <a href="/blog" class="nav-link">
        <span class="bangla-text">সরকারি নিউজ ব্লগ</span>
      </a>
    </nav>

    <!-- ── Right Controls ── -->
    <div style="display:flex; align-items:center; gap:0.75rem;">

      <!-- BN/EN toggle (desktop) -->
      <div class="lang-toggle desktop-only" style="display:flex; align-items:center; gap:0.25rem; cursor:pointer;">
        <span style="color:var(--color-primary); font-weight:600; font-size:0.875rem;">BN</span>
        <span style="color:var(--color-on-surface-variant); font-size:0.875rem;">/</span>
        <span style="color:var(--color-on-surface-variant); font-size:0.875rem; font-weight:600;">EN</span>
      </div>

      <!-- Dark mode toggle (desktop) -->
      <button
        class="icon-btn desktop-only"
        @click="toggleDark()"
        :title="isDark ? 'Switch to light mode' : 'Switch to dark mode'"
        aria-label="Toggle dark mode"
      >
        <span class="material-symbols-outlined" x-text="isDark ? 'light_mode' : 'dark_mode'" style="font-size:1.25rem; color:var(--color-on-surface-variant);"></span>
      </button>

      <!-- Support (desktop) -->
      <a href="/support" class="btn-secondary desktop-only" style="font-size:0.8125rem; padding: 0.4rem 1rem;">Support</a>

      <!-- Sign In -->
      <a href="/sign-in" class="btn-primary" style="font-size:0.8125rem; padding: 0.5rem 1.25rem;">Sign In</a>

      <!-- Mobile hamburger -->
      <button
        class="icon-btn mobile-only"
        @click="mobileOpen = true"
        aria-label="Open menu"
      >
        <span class="material-symbols-outlined" style="color:var(--color-on-surface);">menu</span>
      </button>
    </div>
  </div>

  <!-- ── Mobile Drawer ── -->
  <div
    class="mobile-drawer"
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @keydown.escape.window="mobileOpen = false"
    style="display:none;"
  >
    <div class="mobile-drawer-overlay" @click="mobileOpen = false"></div>
    <div class="mobile-drawer-panel">
      <!-- Drawer header -->
      <div style="display:flex; align-items:center; justify-content:space-between; padding-bottom:1rem; border-bottom: 1px solid var(--color-border-subtle);">
        <span class="text-headline-sm" style="color:var(--color-primary); font-weight:700;">Govt Tools</span>
        <button class="icon-btn" @click="mobileOpen = false" aria-label="Close menu">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <!-- Drawer links -->
      <nav style="display:flex; flex-direction:column; gap:0.25rem;">
        <a href="/" class="drawer-link active-drawer bangla-text">🏠 হোম</a>
        <a href="/tools" class="drawer-link bangla-text">🔧 সবগুলো টুলস</a>
        <a href="/blog" class="drawer-link bangla-text">📰 সরকারি নিউজ ব্লগ</a>
        <hr style="border-color: var(--color-border-subtle); margin: 0.5rem 0;">
        <a href="/tools/pay-scale-2026" class="drawer-link bangla-text">💰 পে স্কেল ২০২৬</a>
        <a href="/tools/salary" class="drawer-link bangla-text">📊 বেতন ক্যালকুলেটর</a>
        <a href="/tools/pension" class="drawer-link bangla-text">👴 পেনশন ক্যালকুলেটর</a>
        <a href="/tools/gpf" class="drawer-link bangla-text">📈 জিপিএফ মুনাফা</a>
      </nav>

      <div style="margin-top:auto; display:flex; gap:0.75rem; padding-top:1rem; border-top: 1px solid var(--color-border-subtle);">
        <a href="/sign-in" class="btn-primary" style="flex:1; justify-content:center;">Sign In</a>
        <button class="icon-btn" @click="toggleDark()" aria-label="Toggle dark mode">
          <span class="material-symbols-outlined" x-text="isDark ? 'light_mode' : 'dark_mode'"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  /* Desktop/Mobile visibility */
  .desktop-nav { display: flex !important; }
  .desktop-only { display: flex !important; }
  .mobile-only  { display: none !important; }

  @media (max-width: 900px) {
    .desktop-nav  { display: none !important; }
    .desktop-only { display: none !important; }
    .mobile-only  { display: flex !important; }
  }

  /* Nav links */
  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-on-surface-variant);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.25rem 0;
    position: relative;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active { color: var(--color-primary); }

  .nav-active-bar {
    position: absolute;
    bottom: -0.75rem;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-primary);
    border-radius: var(--radius-full);
    opacity: 0;
  }

  .nav-link.active .nav-active-bar { opacity: 1; }

  .nav-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: inherit;
    font-family: inherit;
  }

  .mega-link {
    color: var(--color-on-surface-variant);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  .mega-link:hover { color: var(--color-primary); }

  /* Icon button */
  .icon-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.375rem;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }

  .icon-btn:hover { background: var(--color-surface-container); }

  /* Drawer links */
  .drawer-link {
    color: var(--color-on-surface);
    text-decoration: none;
    padding: 0.75rem 0.5rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .drawer-link:hover { background: var(--color-surface-container); color: var(--color-primary); }
  .active-drawer { color: var(--color-primary); font-weight: 600; }

  /* Brand logo hover */
  .brand-logo:hover span:last-child { color: var(--color-primary-container); }

  [x-cloak] { display: none !important; }
</style>

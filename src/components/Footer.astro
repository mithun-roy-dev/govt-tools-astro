---
// Footer.astro — Full footer with brand, links, social icons, disclaimer
---

<footer class="footer-wrapper">
  <div class="container">
    <div class="footer-card">

      <!-- Top grid: brand + link columns -->
      <div class="footer-top">

        <!-- Brand column -->
        <div class="footer-brand">
          <a href="/" class="footer-logo" aria-label="Govt Tools home">
            <span class="material-symbols-outlined" style="font-size:2rem; color:var(--color-primary);">account_balance</span>
            <span class="text-headline-sm" style="color:var(--color-on-surface); font-weight:700;">Govt Tools</span>
          </a>

          <p class="footer-desc bangla-text">
            আপনার প্রতিদিনের দাপ্তরিক কাজকে সহজ করতে সরকারি চাকরিজীবীদের জন্য
            বিশেষায়িত সব প্রয়োজনীয় ডিজিটাল টুলস।
          </p>

          <p class="footer-disclaimer">
            GovtTools is an independent utility website. We are not affiliated, associated,
            authorized, or endorsed by the Government of Bangladesh or any ministry.
          </p>

          <!-- Social icons -->
          <div class="footer-socials">

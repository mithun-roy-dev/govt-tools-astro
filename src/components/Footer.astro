          </div>
        </div>

        <!-- Link columns -->
        <div class="footer-links">

          <div class="link-col">
            <h4 class="link-col-heading">Tools</h4>
            <ul class="link-list">
              <li><a href="/tools/pay-scale-2026" class="footer-link bangla-text">পে স্কেল ২০২৬</a></li>
              <li><a href="/tools/salary" class="footer-link bangla-text">বেতন ক্যালকুলেটর</a></li>
              <li><a href="/tools/pension" class="footer-link bangla-text">পেনশন ক্যালকুলেটর</a></li>
              <li><a href="/tools/gpf" class="footer-link bangla-text">জিপিএফ মুনাফা</a></li>
              <li><a href="/tools" class="footer-link bangla-text">সবগুলো টুলস →</a></li>
            </ul>
          </div>

          <div class="link-col">
            <h4 class="link-col-heading">Resources</h4>
            <ul class="link-list">
              <li><a href="/blog" class="footer-link bangla-text">সরকারি নিউজ</a></li>
              <li><a href="/guide" class="footer-link">User Guide</a></li>
              <li><a href="/faq" class="footer-link">FAQ</a></li>
              <li><a href="/support" class="footer-link">Support</a></li>
            </ul>
          </div>

          <div class="link-col">
            <h4 class="link-col-heading">Company</h4>
            <ul class="link-list">
              <li><a href="/about" class="footer-link">About</a></li>
              <li><a href="/privacy" class="footer-link">Privacy Policy</a></li>
              <li><a href="/terms" class="footer-link">Terms of Service</a></li>
              <li><a href="/contact" class="footer-link">Contact</a></li>
            </ul>
          </div>

        </div>
      </div>

      <!-- Bottom bar -->
      <div class="footer-bottom">
        <p class="footer-copy">
          &copy; 2025 Govt Tools — Employee Utility Portal. All rights reserved.
        </p>
        <div class="footer-bottom-links">
          <a href="/privacy" class="footer-link">Privacy Policy</a>
          <a href="/terms" class="footer-link">Terms of Service</a>
          <a href="/cookies" class="footer-link">Cookie Settings</a>
        </div>
      </div>

    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    background: var(--color-background);
    padding: 2rem var(--gutter) 3rem;
  }

  .footer-card {
    background: var(--color-surface-container-lowest);
    border: 1px solid var(--color-outline-variant);
    border-radius: 2.5rem;
    padding: 3rem 3.5rem;
    box-shadow: 0 4px 24px rgba(0,0,0,0.05);
  }

  .dark .footer-card {
    background: var(--color-surface-container);
    border-color: var(--color-outline);
  }

  @media (max-width: 768px) {
    .footer-card { padding: 2rem 1.5rem; border-radius: 1.5rem; }
  }

  /* Top section */
  .footer-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 800px) {
    .footer-top { grid-template-columns: 1fr; gap: 2rem; }
  }

  /* Brand */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-desc {
    color: var(--color-on-surface-variant);
    font-size: 0.9375rem;
    line-height: 1.7;
    max-width: 360px;
  }

  .footer-disclaimer {
    color: var(--color-on-surface-variant);
    font-size: 0.75rem;
    opacity: 0.7;
    max-width: 360px;
    line-height: 1.6;
  }

  /* Social icons */
  .footer-socials {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .social-icon {
    color: var(--color-on-surface-variant);
    transition: color 0.2s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
  }

  .social-icon:hover {
    color: var(--color-primary);
    transform: translateY(-2px);
  }

  /* Link columns */
  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 480px) {
    .footer-links { grid-template-columns: repeat(2, 1fr); }
  }

  .link-col { display: flex; flex-direction: column; gap: 1.25rem; }

  .link-col-heading {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-on-surface);
    margin: 0;
  }

  .link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    color: var(--color-on-surface-variant);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  .footer-link:hover { color: var(--color-primary); }

  /* Bottom bar */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-outline-variant);
  }

  .footer-copy {
    color: var(--color-on-surface-variant);
    font-size: 0.8125rem;
  }

  .footer-bottom-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
</style>

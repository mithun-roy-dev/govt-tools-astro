---
// CategoryNav.astro — Sticky horizontal pill filter bar
// Alpine.js handles active state; sections filtered by scroll / click
---

<section
  class="category-nav-wrapper"
  x-data="{
    active: 'all',
    setActive(cat) {
      this.active = cat;
      if (cat === 'all') {
        document.querySelectorAll('.tool-section').forEach(s => s.style.display = '');
      } else {
        document.querySelectorAll('.tool-section').forEach(s => {
          s.style.display = s.dataset.cat === cat ? '' : 'none';
        });
      }
    }
  }"
  x-cloak
>
  <div class="container">
    <div class="pill-bar no-scrollbar" role="tablist" aria-label="Tool categories">

      <button
        class="bangla-text"
        :class="active === 'all' ? 'btn-pill-active' : 'btn-pill-inactive'"
        @click="setActive('all')"
        role="tab"
        :aria-selected="active === 'all'"
      >
        সবগুলো
      </button>

      <button
        class="bangla-text"
        :class="active === 'finance' ? 'btn-pill-active' : 'btn-pill-inactive'"
        @click="setActive('finance')"
        role="tab"
        :aria-selected="active === 'finance'"
      >
        <span style="display:inline-flex; align-items:center; gap:0.25rem;">
          💰 আর্থিক ও বেতন
        </span>
      </button>

      <button
        class="bangla-text"
        :class="active === 'pension' ? 'btn-pill-active' : 'btn-pill-inactive'"
        @click="setActive('pension')"
        role="tab"
        :aria-selected="active === 'pension'"
      >
        <span style="display:inline-flex; align-items:center; gap:0.25rem;">
          👴 পেনশন ও অবসর
        </span>
      </button>

      <button
        class="bangla-text"
        :class="active === 'utility' ? 'btn-pill-active' : 'btn-pill-inactive'"
        @click="setActive('utility')"
        role="tab"
        :aria-selected="active === 'utility'"
      >
        <span style="display:inline-flex; align-items:center; gap:0.25rem;">
          🔧 ইউটিলিটি টুলস
        </span>
      </button>

      <button
        class="bangla-text"
        :class="active === 'admin' ? 'btn-pill-active' : 'btn-pill-inactive'"
        @click="setActive('admin')"
        role="tab"
        :aria-selected="active === 'admin'"
      >
        <span style="display:inline-flex; align-items:center; gap:0.25rem;">
          🗂️ প্রশাসন ও রেকর্ড
        </span>
      </button>

    </div>
  </div>
</section>

<style>
  .category-nav-wrapper {
    position: sticky;
    top: 64px;          /* matches header height */
    z-index: 40;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border-subtle);
    padding-block: 0.875rem;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .pill-bar {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding-bottom: 2px; /* room for focus rings */
  }

  .btn-pill-active,
  .btn-pill-inactive {
    font-family: 'Hind Siliguri', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-full);
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease, transform 0.1s ease;
    flex-shrink: 0;
  }

  .btn-pill-active:active,
  .btn-pill-inactive:active { transform: scale(0.96); }

  .btn-pill-active:focus-visible,
  .btn-pill-inactive:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  [x-cloak] { display: none !important; }
</style>
